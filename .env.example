# =============================================
# 复制此文件为 .env 并填入实际配置
#
# 标注说明:
#   [必填] - 不配置则应用核心功能不可用
#   [选填] - 有合理默认值，按需配置
# =============================================

# ===== 基础配置 =====
# [必填] 待分析股票列表(逗号分隔)，Web模式下可通过API传入，其他模式必须配置
STOCK_LIST=600519,002594,300750,hk00700,AAPL

# [选填] 目标市场: A/HK/US (默认: A)
MARKET=A

# [选填] 历史数据天数 (默认: 60)
HISTORY_DAYS=60

# [选填] 时区 (默认: Asia/Shanghai)
TIMEZONE=Asia/Shanghai

# ===== LLM配置 (AI分析核心) =====
# [必填] OpenAI兼容API地址 (默认: 阿里云百炼)
LLM_API=https://dashscope.aliyuncs.com/compatible-mode/v1

# [必填] API密钥 - 没有此配置AI分析功能完全不可用
LLM_API_KEY=sk-xxx

# [选填] LLM模型名称 (默认: qwen3.7-plus)
LLM_MODEL=qwen3.7-plus

# [选填] 备用LLM渠道(格式: provider://api_key@endpoint/model)
LLM_CHANNELS=

# [选填] Agent模式: quick/standard/full/specialist (默认: standard)
AGENT_MODE=standard

# ===== 数据源配置 =====
# [选填] 首选数据源: auto/efinance/akshare/tushare/tencent/yfinance (默认: auto)
DATA_PROVIDER=auto

# [选填] Tushare Token(配置后可使用Tushare数据源)
TUSHARE_TOKEN=

# [选填] Finnhub API Key(美股数据源)
FINNHUB_API_KEY=

# [选填] Alpha Vantage API Key
ALPHAVANTAGE_API_KEY=

# [选填] Longbridge(港股/美股数据源)
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# [选填] TickFlow数据源
TICKFLOW_API_KEY=
TICKFLOW_BASE_URL=https://api.tickflow.org

# ===== 搜索/新闻配置 =====
# [选填] 搜索引擎: tavily/anspire (默认: tavily)
SEARCH_PROVIDER=tavily

# [选填] Tavily API Key (使用tavily搜索时需要)
TAVILY_API_KEY=

# [选填] Anspire API Key (使用anspire搜索时需要)
ANSPIRE_API_KEY=

# [选填] 新闻搜索最大结果数 (默认: 5)
NEWS_MAX_RESULTS=5

# ===== 通知渠道配置 =====
# [选填] 启用的通知渠道(逗号分隔)，不配置则不发送通知
NOTIFICATION_CHANNELS=

# [选填] 企业微信 Webhook
WECOM_WEBHOOK=

# [选填] 飞书 Webhook
FEISHU_WEBHOOK=

# [选填] 钉钉 Webhook
DINGTALK_WEBHOOK=

# [选填] 邮件通知
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ===== 认证配置 =====
# [选填] 是否启用认证 (默认: false)
AUTH_ENABLED=false

# [选填] JWT密钥 (启用认证时建议修改)
AUTH_SECRET=your-jwt-secret-change-me

# [选填] 认证密码
AUTH_PASSWORD=

# ===== 定时调度 =====
# [选填] Cron表达式 (默认: 工作日18:00)
SCHEDULE_CRON=0 0 18 * * MON-FRI

# ===== 用户画像 =====
# [选填] 未设置画像时的默认风险档位 (可选: CONSERVATIVE/BALANCED/AGGRESSIVE, 默认: BALANCED)
USER_DEFAULT_RISK_TOLERANCE=BALANCED

# ===== 买点三灯决策 =====
# [选填] 决策评估拉取 K 线的日历日窗口 (默认: 500，最小 300 以满足 MA200 所需样本)
DECISION_HISTORY_DAYS=500
# [选填] A 股基准指数代码 (势灯相对强度与大盘 risk-off 判定, 默认: 000300 沪深300)
DECISION_BENCHMARK_CODE=000300
# [选填] 单票建议仓位市值占可用资金上限 (0~1, 默认: 1.0 仅受市值≤资金约束)
DECISION_MAX_POSITION_PCT=1.0

# ===== 服务配置 =====
# [选填] 服务端口 (默认: 8000)
SERVER_PORT=8000

# [选填] 服务绑定地址 (默认: 0.0.0.0)
SERVER_HOST=0.0.0.0

# ===== 数据源主动体检 =====
# [选填] 体检结果缓存 TTL 秒数 (默认: 300, 体检自身串行+缓存优先, 避免加剧上游限流)
DATASOURCE_DOCTOR_TTL_SECONDS=300
# [选填] 探针标的: A 股 (默认: 600519)
DATASOURCE_DOCTOR_PROBE_A=600519
# [选填] 探针标的: 美股 (默认: AAPL)
DATASOURCE_DOCTOR_PROBE_US=AAPL
# [选填] 探针标的: 港股 (默认: 00700)
DATASOURCE_DOCTOR_PROBE_HK=00700
# [选填] 探针回看天数 (默认: 14)
DATASOURCE_DOCTOR_PROBE_DAYS=14

# ===== alpha-forge-skill CLI 桥接 =====
# [选填] alpha-forge-skill 仓库根目录(含 scripts/)，配置后启用桥接 Agent 工具：
#   stage_analysis(阶段定位七态) / dca_plan(定投XIRR) /
#   strategy_validate(走步+PBO验证) / screener_preset(方法论预设筛选)
# 未配置时不注册任何桥接 Bean，对现有功能零影响
SKILL_BRIDGE_DIR=
# [选填] 桥接命令超时秒数 (默认: 300，全市场筛选较慢可调大)
SKILL_BRIDGE_TIMEOUT_SECONDS=300
# [选填] uv 可执行文件名/路径 (默认: uv)
SKILL_BRIDGE_UV_BIN=uv
